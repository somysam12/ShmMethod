<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent navy glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14284CFF"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <!-- Top sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#2229B6FF"
                android:centerColor="#0A1E90FF"
                android:endColor="#00000000"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <!-- Blue glass border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#4029B6FF"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
