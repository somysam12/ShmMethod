<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer electric-blue ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#5529B6FF"/>
        </shape>
    </item>
    <!-- Mid violet ring -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#557A3FFF"/>
        </shape>
    </item>
    <!-- Inner dark disc with bright rim -->
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#0A1428"/>
            <stroke android:width="2dp" android:color="#2E9BFF"/>
        </shape>
    </item>
</layer-list>
