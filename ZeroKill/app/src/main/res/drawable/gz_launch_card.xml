<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- gradient edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient android:type="linear" android:angle="135"
                android:startColor="#332E9BFF"
                android:centerColor="#22000000"
                android:endColor="#337A3FFF"/>
        </shape>
    </item>
    <!-- inner fill -->
    <item android:left="1.4dp" android:top="1.4dp" android:right="1.4dp" android:bottom="1.4dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#111E3A" android:endColor="#0A1226"/>
        </shape>
    </item>
</layer-list>
