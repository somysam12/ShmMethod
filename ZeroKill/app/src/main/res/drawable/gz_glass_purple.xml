<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Purple translucent glass base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B32A1256"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <!-- Violet -> blue sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#557A3FFF"
                android:centerColor="#22532E9C"
                android:endColor="#11201653"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <!-- Bright glass border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1.5dp" android:color="#66B39BFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
</layer-list>
