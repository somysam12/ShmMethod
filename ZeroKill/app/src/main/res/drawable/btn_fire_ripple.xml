<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FF8833">
    <item>
        <layer-list>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#55FF5500"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <gradient
                        android:startColor="#E84A10"
                        android:centerColor="#CC3A08"
                        android:endColor="#B82E00"
                        android:angle="270"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="1dp" android:color="#FF7733"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
