<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep navy base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear" android:angle="270"
                android:startColor="#0B1428"
                android:centerColor="#070E1E"
                android:endColor="#03060E"/>
        </shape>
    </item>
    <!-- Top electric-blue glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="620"
                android:centerX="0.5" android:centerY="0.16"
                android:startColor="#3321A0FF"
                android:centerColor="#140F5FE0"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <!-- Lower violet ambience -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="560"
                android:centerX="0.5" android:centerY="0.92"
                android:startColor="#227A3FFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
