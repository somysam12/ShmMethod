<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/zk_surface"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/zk_fire_line"
        android:alpha="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/zk_logo"
            android:scaleType="fitCenter"
            android:background="@null" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text=""
            android:textSize="16sp"
            android:textColor="@color/zk_fire_bright"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/zk_fire_line"
        android:alpha="0.4"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/zk_text_secondary"
        android:fontFamily="@font/rajdhani_bold"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/zk_btn_ghost"
            android:text="CANCEL"
            android:textColor="@color/zk_fire_mid"
            android:textSize="13sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/zk_btn_fire"
            android:text="OK"
            android:textColor="@color/zk_text_primary"
            android:textSize="13sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

</LinearLayout>
