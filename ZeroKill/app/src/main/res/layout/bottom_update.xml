<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/zk_surface"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/zk_fire_line"
        android:alpha="0.5" />

    <ImageView
        android:id="@+id/dialog_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/zk_logo"
        android:scaleType="fitCenter"
        android:background="@null"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="UPDATE AVAILABLE"
        android:textSize="18sp"
        android:textColor="@color/zk_fire_bright"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/zk_fire_line"
        android:alpha="0.4"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/zk_text_secondary"
        android:fontFamily="@font/rajdhani_bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="20dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/updateee"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/zk_btn_fire"
        android:text="UPDATE NOW"
        android:textColor="@color/zk_text_primary"
        android:textSize="14sp"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cancle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/zk_btn_ghost"
        android:text="LATER"
        android:textColor="@color/zk_fire_mid"
        android:textSize="13sp"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/zk_btn_ghost"
        android:text="OK"
        android:textColor="@color/zk_text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:visibility="gone" />

</LinearLayout>
